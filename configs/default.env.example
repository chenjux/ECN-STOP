# Copy this file to a local env file and source it before running scripts.
# Example: set -a; source configs/default.env.example; set +a

MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
MODEL_SPECS=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B=qwen7b
DATASET_DIR=./data
OUTPUT_BASE_DIR=./train/model
LOG_DIR=./train/log
RUN_DIR=./runs/train_benchmark_example

# Comma-separated values consumed by train/run.sh.
DATASETS=./data/ecn_self_distill_qwen.jsonl
MAX_LENGTHS=8192
SEEDS=1

CUDA_VISIBLE_DEVICES=0
SWIFT_CLI=swift

# Evaluation defaults.
EVAL_DATASETS=math_500
EVAL_BASE_PORT=8801
BENCHMARK_DATASETS=math_500
BENCHMARK_BASE_PORT=8801
BENCHMARK_GPU_ID=0
